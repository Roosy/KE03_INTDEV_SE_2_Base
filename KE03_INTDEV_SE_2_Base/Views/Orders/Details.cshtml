@model DataAccessLayer.Models.Order

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Bestelling</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            Klant
        </dt>
        <dd class="col-sm-10">
            <strong>@Model.Customer.FirstName @Model.Customer.LastName</strong><br />
            @Model.Customer.Email<br />
            @Model.Customer.Address, @Model.Customer.Postcode @Model.Customer.City
        </dd>

        <dt class="col-sm-2">
            Besteldatum
        </dt>
        <dd class="col-sm-10">
            @Model.OrderDate.ToString("dd-MM-yyyy HH:mm")
        </dd>

        <dt class="col-sm-2">
            Totaalbedrag
        </dt>
        <dd class="col-sm-10">
            € @Model.TotalAmount.ToString("0.00")
        </dd>

        <dt class="col-sm-2">
            Orderitems
        </dt>
        <dd class="col-sm-10">
            @if (Model.OrderItems != null && Model.OrderItems.Any())
            {
                <ul>
                    @foreach (var item in Model.OrderItems)
                    {
                        <li>OrderItem #@item.Id</li>
                    }
                </ul>
            }
            else
            {
                <span>Geen orderitems gekoppeld.</span>
            }
        </dd>

    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Terug naar index</a>
</div>