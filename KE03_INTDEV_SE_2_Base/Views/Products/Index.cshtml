@model IEnumerable<DataAccessLayer.Models.Product>

@{
    ViewData["Title"] = "Producten";

    var categories = Model
        .Select(p => p.ProductCategory?.Name)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct()
        .OrderBy(name => name);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">
        Producten
        <span class="badge bg-secondary">@Model.Count()</span>
    </h1>

    <a asp-action="Create" class="btn btn-success">
        + 
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-6">
                <input type="text"
                       id="productSearch"
                       class="form-control"
                       placeholder="Zoek producten..." />
            </div>

            <div class="col-md-3">
                <select id="categoryFilter" class="form-select">
                    <option value="">Alle categorieën</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select id="sortFilter" class="form-select">
                    <option value="">Sorteer op</option>
                    <option value="az">Naam A-Z</option>
                    <option value="za">Naam Z-A</option>
                    <option value="price-low">Prijs laag-hoog</option>
                    <option value="price-high">Prijs hoog-laag</option>
                </select>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Er zijn nog geen producten toegevoegd.
    </div>
}
else
{
    <table id="productenTabel" class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Item</th>
                <th>Product</th>
                <th>Categorie</th>
                <th>Prijs</th>
                <th>Aantal</th>
                <th>Status</th>
                <th class="text-end">Acties</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var aantal = item.Inventory?.Quantity ?? 0;
                var status = aantal <= 0 ? "Niet op voorraad" : aantal < 10 ? "Lage voorraad" : "Op voorraad";
                var categoryName = item.ProductCategory?.Name ?? "Geen categorie";

                <tr data-category="@categoryName" data-name="@item.Name" data-price="@item.Price">
                    <td>@item.Id</td>

                    <td>
                        <strong>
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="text-dark text-black text-decoration-none">
                                @item.Name
                            
                            </a>
                        
                        </strong>
                        <br />
                        <small class="text-muted">@(item.Description ?? "Geen beschrijving")</small>
                    </td>

                    <td>
                        <span class="badge bg-light text-dark border">@categoryName</span>
                    </td>

                    <td>@item.Price.ToString("€ 0.00")</td>

                    <td>
                        <span class="badge bg-success-subtle text-success border">@aantal</span>
                    </td>

                    <td>
                        @if (status == "Niet op voorraad")
                        {
                            <span class="badge bg-danger">@status</span>
                        }
                        else if (status == "Lage voorraad")
                        {
                            <span class="badge bg-warning text-dark">@status</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@status</span>
                        }
                    </td>

                    <td class="text-end">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn text-primary"
                           title="Bewerken">
                            <i class="bi bi-pencil-square fs-5"></i>
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn text-danger"
                           title="Verwijderen">
                            <i class="bi bi-trash-fill fs-5"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
      
