@model DataAccessLayer.Models.Product

@{
    ViewData["Title"] = "Productdetails";

    var aantal = Model.Inventory?.Quantity ?? 0;
    var status = aantal <= 0 ? "Niet op voorraad" : aantal < 10 ? "Lage voorraad" : "Op voorraad";
    var statusClass = status == "Niet op voorraad" ? "bg-danger" :
                      status == "Lage voorraad" ? "bg-warning text-dark" :
                      "bg-success";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Productdetails</h1>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark">
        Bewerken
    </a>
</div>

<h2 class="h3 mb-4">@Model.Name</h2>

<a asp-action="Index" class="btn btn-link ps-0 mb-3">
    Terug naar producten
</a>

<div class="card">
    <div class="card-body">
        <h3 class="h5 mb-4">Productinformatie</h3>

        <div class="row g-4">
            <div class="col-md-4">
                <small class="text-muted">Productnummer</small>
                <div>@Model.Id</div>
            </div>

            <div class="col-md-4">
                <small class="text-muted">Categorie</small>
                <div>@(Model.ProductCategory?.Name ?? "Geen categorie")</div>
            </div>

            <div class="col-md-4">
                <small class="text-muted">Prijs</small>
                <div>@Model.Price.ToString("€ 0.00")</div>
            </div>

            <div class="col-md-4">
                <small class="text-muted">Aantal</small>
                <div>
                    <span class="badge bg-light text-dark border">@aantal</span>
                </div>
            </div>

            <div class="col-md-4">
                <small class="text-muted">Status</small>
                <div>
                    <span class="badge @statusClass">@status</span>
                </div>
            </div>

            <div class="col-md-4">
                <small class="text-muted">Laatst bijgewerkt</small>
                <div>
                    @(Model.Inventory?.LastUpdated.ToString("dd-MM-yyyy HH:mm") ?? "Onbekend")
                </div>
            </div>

            <div class="col-12">
                <small class="text-muted">Beschrijving</small>
                <div>@(Model.Description ?? "Geen beschrijving")</div>
            </div>

            <div class="col-12">
                <small class="text-muted">Onderdelen</small>
                <div>
                    @if (Model.Parts.Any())
                    {
                        foreach (var part in Model.Parts)
                        {
                            <span class="badge bg-light text-dark border me-1">
                                @part.Name
                            </span>
                        }
                    }
                    else
                    {
                        <span>Geen onderdelen gekoppeld</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>