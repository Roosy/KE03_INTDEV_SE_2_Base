<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KE03_INTDEV_SE_2_Base</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KE03_INTDEV_SE_2_Base.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<!-- Layout door jonah 1-6 -->
<body>

    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar bg-dark text-white p-3">
            <h4 class="mb-4">Matrix Inc.</h4>

            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                        Home
                    </a>
                </li>

                <li class="nav-catagory">Klantbeheer</li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Customers" asp-action="Index">
                        Klanten
                    </a>
                </li>

                <li class="nav-catagory">Bestellingen</li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Orders" asp-action="Index">
						Bestellingen
					</a>
				</li>

                <li class="nav-catagory">Productbeheer</li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Products" asp-action="Index">
                        Producten
					</a>
				</li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="ProductCategories" asp-action="Index">
						Categorieën
                    </a>
                </li>

                <li class="nav-catagory"></li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">
                        Privacy
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main content -->
        <div class="content flex-grow-1">
            <main class="container-fluid p-4">
                @RenderBody()
            </main>

            <footer class="border-top text-muted p-3">
                &copy; 2026 - Matrix Inc. -
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
<!-- Layout door jonah 1-6 -->
</html>