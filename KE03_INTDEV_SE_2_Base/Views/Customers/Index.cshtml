@model IEnumerable<DataAccessLayer.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="customer-container">

    <div class="toolbar">

        <div class="search-filter-group">

            <!-- Zoekbalk -->
            <div class="search-container">

                <input type="text"
                       id="searchInput"
                       class="search-box"
                       placeholder="Zoeken..." />

                <button type="button"
                        id="clearSearch"
                        class="clear-search-btn">
                    <i class="bi bi-x-lg"></i>
                </button>

            </div>

            <!-- Filter code -->
            <div class="filter-wrapper">

                <button type="button"
                        id="filterToggle"
                        class="filter-btn">
                    <i class="bi bi-funnel-fill"></i>
                    Filter
                </button>

                <button type="button"
                        id="clearFilter"
                        class="clear-filter-btn">
                    <i class="bi bi-x-circle"></i>
                    Herstel
                </button>

                <div id="filterPanel" class="filter-panel">

                    <label>Categorie</label>

                    <select id="filterColumn" class="filter-select">
                        <option value="">Kies Categorie</option>
                        <option value="0">Klant ID</option>
                        <option value="1">Email</option>
                        <option value="2">Voornaam</option>
                        <option value="3">Achternaam</option>
                        <option value="4">Adres</option>
                        <option value="5">Postcode</option>
                        <option value="6">Stad</option>
                    </select>

                    <label>Waarde</label>

                    <select id="filterValue" class="filter-select">
                        <option value="">Alles</option>
                    </select>

                </div>

            </div>

        </div>

        <a asp-action="Create" class="create-btn">
            <i class="bi bi-plus-lg"></i>
        </a>

    </div>

    <table class="table customer-table" id="customerTable">

        <thead>
            <tr>
                <th>Klant ID</th>
                <th>Email</th>
                <th>Voornaam</th>
                <th>Achternaam</th>
                <th>Adres</th>
                <th>Postcode</th>
                <th>Stad</th>
                <th class="actions-column"></th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr class="customer-row"
                    data-url="@Url.Action("Details", new { id = item.Id })">

                    <th>@item.CustomerId.ToString("D5")</th>
                    <td>@item.Email</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.Address</td>
                    <td>@item.Postcode</td>
                    <td>@item.City</td>

                    <td class="action-buttons">

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="icon-btn edit-btn">

                            <i class="bi bi-pencil-fill"></i>
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="icon-btn delete-btn">

                            <i class="bi bi-trash-fill"></i>
                        </a>

                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts {
    <script src="~/js/customer-index.js"></script>
}
